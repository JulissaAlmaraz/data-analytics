#While Loop

bank_balance = 12000
savings_goal = 20000
weekly_savings = 450
treat = 50

while bank_balance < savings_goal:
    bank_balance += weekly_savings

    if bank_balance >= (savings_goal * 0.5) and bank_balance < (savings_goal * 0.75):
        print(f'Almost there! This week my balance is up to ${bank_balance}')
    elif bank_balance >=(savings_goal * 0.75) and (bank_balance - weekly_savings) < (savings_goal * 0.75):
        bank_balance -= treat
        print(f'So close! After trating myself, my balance is up to ${bank_balance}.')
    elif bank_balance < savings_goal:
        print(f'So close! After treating myself, my balance is up to ${bank_balance}')

print(f'Goal met! My current balance is ${bank_balance}')